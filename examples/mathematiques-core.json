{
  "catalogue": {
    "id": "mathematiques-core",
    "version": "math-core-v1",
    "description": "Catalogue explicite du calculateur AST local. Les descriptions peuvent etre importees en memoire, jamais les resultats ordinaires.",
    "learning_level": 4,
    "maturity": "operational",
    "learning_levels": [
      {"level": 1, "state": "received"},
      {"level": 2, "state": "observed"},
      {"level": 3, "state": "consolidated"},
      {"level": 4, "state": "operational"}
    ],
    "regles_securite": [
      "Analyse uniquement une expression AST en mode eval.",
      "Interdit eval, exec, import, attributs, indexation, lambda et comprehensions.",
      "Applique des limites de taille, noeuds, profondeur, exposant, combinatoire, bits et chiffres.",
      "N'ecrit aucun calcul ordinaire dans la memoire associative."
    ],
    "operateurs": ["+", "-", "*", "/", "//", "%", "**", "+ unaire", "- unaire"],
    "constantes": ["pi", "e", "tau"],
    "categories": {
      "arithmetic": {
        "description": "Arithmetique, reductions et arrondis.",
        "fonctions": ["abs", "round", "floor", "ceil", "trunc", "sum", "fsum", "prod", "min", "max"]
      },
      "roots_logs": {
        "description": "Racines, normes, exponentielles et logarithmes.",
        "fonctions": ["sqrt", "isqrt", "exp", "log", "log2", "log10", "hypot"]
      },
      "trigonometry": {
        "description": "Trigonometrie reelle et conversion des angles.",
        "fonctions": ["sin", "cos", "tan", "asin", "acos", "atan", "atan2", "degrees", "radians"]
      },
      "integers_combinatorics": {
        "description": "Calculs entiers et combinatoires bornes.",
        "fonctions": ["gcd", "lcm", "factorial", "comb", "perm"]
      },
      "statistics": {
        "description": "Statistiques descriptives sur listes ou tuples bornes.",
        "fonctions": ["mean", "fmean", "median", "median_low", "median_high", "pvariance", "pstdev", "variance", "stdev"]
      },
      "exact": {
        "description": "Construction rationnelle exacte.",
        "fonctions": ["frac"]
      }
    },
    "exemples": [
      {"expression": "2 + 3 * 4", "affichage": "14", "type": "integer", "exact": true},
      {"expression": "frac(1, 3) + frac(1, 6)", "affichage": "1/2", "type": "fraction", "exact": true},
      {"expression": "sqrt(81)", "affichage": "9", "type": "float", "exact": false},
      {"expression": "mean([2, 4, 6, 8])", "affichage": "5", "type": "integer", "exact": true},
      {"expression": "sin(pi / 2)", "affichage": "1", "type": "float", "exact": false},
      {"expression": "comb(10, 3)", "affichage": "120", "type": "integer", "exact": true}
    ]
  }
}
